# Server Configuration
PORT=3000

# Database Configuration
# Database file location (relative to project root)
DATABASE_PATH=./database/data.db

# File Upload Configuration
# Maximum file size for uploads (in bytes)
# Default: 5242880 (5MB)
MAX_FILE_SIZE=5242880

# Maximum image dimensions after processing
# Default: 800px width
MAX_IMAGE_WIDTH=800

# Upload directories (relative to project root)
UPLOAD_DIR_PROFILES=./uploads/profile-photos
UPLOAD_DIR_QR=./uploads/qr-codes
UPLOAD_DIR_LOGOS=./uploads/event-logos
UPLOAD_DIR_QUIZ=./uploads/quiz-images
UPLOAD_DIR_TEAM_CHALLENGE=./uploads/team-challenge
UPLOAD_DIR_PHOTO_CHALLENGE=./uploads/photo-challenge

# Admin Authentication Configuration
# Admin access is protected by QR-code + PIN backup system
# A unique QR code is generated on server startup
# ADMIN_PIN is a backup method if QR code is lost
# Set a 4-6 digit PIN code for admin access
ADMIN_PIN=1234

# Node Environment
NODE_ENV=development
