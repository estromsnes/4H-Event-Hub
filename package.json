{
  "name": "4h-event-hub",
  "version": "1.0.0",
  "description": "4H Event Hub - Social engagement app for camps and events",
  "main": "server.js",
  "scripts": {
    "start": "node database/migrate.js && node server.js",
    "init-db": "node database/migrations/init.js",
    "migrate": "node database/migrate.js",
    "dev": "node database/migrate.js && node server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "4h",
    "event",
    "camp",
    "profile",
    "qr"
  ],
  "author": "Skautrollet 4H",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.19.37",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
